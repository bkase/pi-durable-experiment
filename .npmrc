# The global config holds new releases back 7 days. This experiment targets releases
# from the last week, so only its own ecosystems are exempt.
min-release-age-exclude[]=effect
min-release-age-exclude[]=@effect/*
min-release-age-exclude[]=alchemy
min-release-age-exclude[]=@alchemy.run/*
min-release-age-exclude[]=@distilled.cloud/*
min-release-age-exclude[]=@earendil-works/*
min-release-age-exclude[]=@cloudflare/computer
min-release-age-exclude[]=just-bash
min-release-age-exclude[]=@anthropic-ai/claude-code
min-release-age-exclude[]=@anthropic-ai/claude-code-darwin-arm64
